# Server only. Never prefix a secret with VITE_.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=
AI_MAX_OUTPUT_TOKENS=1024
AI_REASONING_EFFORT=low
# Optional local credential file instead of AI_API_KEY; may contain DEEPSEEK_API_KEY.
# AI_CREDENTIALS_FILE=C:/path/to/auth.json
# Data defaults to ../.runtime/workflow.json, outside the web root.
# Hosting: Render sets RENDER_EXTERNAL_URL automatically.
# APP_ORIGIN=https://your-custom-domain.example
# Shared demo login for the hosted site. Username: demo.
# SITE_PASSWORD=choose-a-long-private-password
# PUBLIC_DEMO=true opens the site without a password and disables changing demo plans.
